import streamlit as st
import matplotlib.pyplot as plt

from utils import load_data, clean_data

# ---------------------------------
# PAGE CONFIG
# ---------------------------------
st.set_page_config(
    page_title="Region Analysis",
    page_icon="🌍",
    layout="wide"
)

# ---------------------------------
# LOAD DATA
# ---------------------------------
df = load_data()
df = clean_data(df)

# ---------------------------------
# TITLE
# ---------------------------------
st.title("🌍 Region Analysis Dashboard")

st.markdown("Analyze sales and profit across different Regions, States and Cities.")

st.markdown("---")

# ---------------------------------
# FILTER
# ---------------------------------
region = st.selectbox(
    "Select Region",
    ["All"] + sorted(df["Region"].unique().tolist())
)

if region != "All":
    df = df[df["Region"] == region]

# ---------------------------------
# REGION SALES
# ---------------------------------
st.subheader("💰 Sales by Region")

region_sales = (
    df.groupby("Region")["Sales"]
    .sum()
    .sort_values(ascending=False)
)

fig, ax = plt.subplots(figsize=(8,5))

ax.bar(
    region_sales.index,
    region_sales.values
)

ax.set_ylabel("Sales")
ax.set_title("Region-wise Sales")

st.pyplot(fig)

st.markdown("---")

# ---------------------------------
# REGION PROFIT
# ---------------------------------
st.subheader("📈 Profit by Region")

region_profit = (
    df.groupby("Region")["Profit"]
    .sum()
    .sort_values(ascending=False)
)

fig, ax = plt.subplots(figsize=(8,5))

ax.bar(
    region_profit.index,
    region_profit.values
)

ax.set_ylabel("Profit")
ax.set_title("Region-wise Profit")

st.pyplot(fig)

st.markdown("---")

# ---------------------------------
# TOP 10 STATES
# ---------------------------------
st.subheader("🏆 Top 10 States by Sales")

state_sales = (
    df.groupby("State")["Sales"]
    .sum()
    .sort_values(ascending=False))